# App
APP_NAME="ТутПроблема API"
APP_ENV=development
DEBUG=true
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# Docker Compose Settings
BACKEND_PORT=8000
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tutproblema
DB_PORT=5432
DATABASE_URL="postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@db:${DB_PORT}/${DB_NAME}"
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_HEALTHCHECK_INTERVAL=10s
DB_HEALTHCHECK_TIMEOUT=5s
DB_HEALTHCHECK_RETRIES=5

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTHCHECK_INTERVAL=10s
REDIS_HEALTHCHECK_TIMEOUT=5s
REDIS_HEALTHCHECK_RETRIES=5
REDIS_MAX_CONNECTIONS=20

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# JWT
SECRET_KEY=change-it-to-your-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TOKEN_ALGORITHM=HS256

# Argon2
ARGON2_TIME_COST=1
ARGON2_MEMORY_COST=19456
ARGON2_PARALLELISM=1
ARGON2_HASH_LEN=16
ARGON2_PEPPER=change-it-to-your-argon2-pepper-string

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS","PATCH"]
CORS_ALLOW_HEADERS=["*"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Password Validation
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_SPECIAL_CHARS="@$!%*?&#"
PASSWORD_DISALLOW_COMMON=true
COMMON_PASSWORDS_FILE=common-passwords.txt

# Username Validation
USERNAME_MIN_LENGTH=3
USERNAME_MAX_LENGTH=50
USERNAME_ALLOWED_PATTERN="^[a-zA-Zа-яА-ЯёЁ0-9_]+$"

# Email Settings
EMAIL_MIN_LENGTH=5
EMAIL_MAX_LENGTH=255
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=temp@gmail.com
SMTP_PASSWORD="abcd efgh ijkl mnop"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
FRONTEND_URL=http://localhost:3000

# Upload Settings
UPLOAD_DIR=uploads
ALLOWED_EXTENSIONS=["jpg","jpeg","png","gif","webp"]
MIN_PHOTOS_PER_REPORT=1
MAX_PHOTOS_PER_REPORT=10
PHOTO_URL_PREFIX=/api/uploads/photos

# Report Settings
REPORT_TITLE_MIN_LENGTH=5
REPORT_TITLE_MAX_LENGTH=200
REPORT_DESCRIPTION_MAX_LENGTH=2000
RESOLUTION_COMMENT_MIN_LENGTH=5
RESOLUTION_COMMENT_MAX_LENGTH=2000
DEFAULT_RADIUS_METERS=1000
MIN_RADIUS_METERS=500
MAX_RADIUS_METERS=3000
MAX_REPORT_DISTANCE_METERS=1000

# Vote Settings
VOTE_VERIFICATION_BUFFER_METERS=50
VOTE_ACCURACY_MAX=1000
MAX_VOTE_DISTANCE_METERS=1000

# Pagination
DEFAULT_PAGE_SIZE=20
MIN_PAGE_SIZE=1
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_INCLUDE_TIMESTAMP=true
LOG_INCLUDE_APP_NAME=true
LOG_INCLUDE_REQUEST_ID=true

# Rate Limiting Settings
RATE_LIMIT_ENABLED=false
RATE_LIMIT_BY_USER=true

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

RATE_LIMIT_GLOBAL_REQUESTS=1000
RATE_LIMIT_GLOBAL_PERIOD_SECONDS=60

RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_PERIOD_SECONDS=60

RATE_LIMIT_API_REQUESTS=200
RATE_LIMIT_API_PERIOD_SECONDS=60

RATE_LIMIT_UPLOAD_REQUESTS=50
RATE_LIMIT_UPLOAD_PERIOD_SECONDS=3600

RATE_LIMIT_VOTE_REQUESTS=30
RATE_LIMIT_VOTE_PERIOD_SECONDS=60

RATE_LIMIT_REPORT_CREATE_REQUESTS=20
RATE_LIMIT_REPORT_CREATE_PERIOD_SECONDS=3600

# Earth radius (meters)
EARTH_RADIUS_METERS=6371000